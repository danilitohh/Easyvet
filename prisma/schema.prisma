  version                             Int                   @default(1)
  testName                            String?               @map("test_name") @db.VarChar(300)
  requestedAt                         DateTime?             @map("requested_at") @db.Timestamptz(3)
  reason                              String?               @db.VarChar(5000)
  instructions                        String?               @db.VarChar(10000)
  notes                               String?               @db.VarChar(10000)
  responsiblePractitionerMembershipId String?               @map("responsible_practitioner_membership_id") @db.Uuid
  createdByMembershipId               String                @map("created_by_membership_id") @db.Uuid
  patientNameSnapshot                 String?               @map("patient_name_snapshot") @db.VarChar(200)
  ownerDisplayNameSnapshot            String?               @map("owner_display_name_snapshot") @db.VarChar(300)
  professionalDisplayNameSnapshot     String?               @map("professional_display_name_snapshot") @db.VarChar(200)
  professionalLicenseSnapshot         String?               @map("professional_license_snapshot") @db.VarChar(160)
  requestedByMembershipId             String?               @map("requested_by_membership_id") @db.Uuid
  resultedAt                          DateTime?             @map("resulted_at") @db.Timestamptz(3)
  resultText                          String?               @map("result_text") @db.VarChar(20000)
  interpretation                      String?               @db.VarChar(10000)
  resultedByMembershipId              String?               @map("resulted_by_membership_id") @db.Uuid
  voidedAt                            DateTime?             @map("voided_at") @db.Timestamptz(3)
  voidedByMembershipId                String?               @map("voided_by_membership_id") @db.Uuid
  voidReason                          String?               @map("void_reason") @db.VarChar(1000)
  createdAt                           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization                        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clinicalEncounter                   ClinicalEncounter     @relation(fields: [clinicalEncounterId, organizationId, patientId], references: [id, organizationId, patientId], onDelete: Restrict, onUpdate: Cascade)
  patient                             Patient               @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  responsiblePractitionerMembership   Membership?           @relation("DiagnosticOrderResponsibleMembership", fields: [responsiblePractitionerMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  createdByMembership                 Membership            @relation("DiagnosticOrderCreatedByMembership", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  requestedByMembership               Membership?           @relation("DiagnosticOrderRequestedByMembership", fields: [requestedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  resultedByMembership                Membership?           @relation("DiagnosticOrderResultedByMembership", fields: [resultedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  voidedByMembership                  Membership?           @relation("DiagnosticOrderVoidedByMembership", fields: [voidedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId], map: "diagnostic_orders_id_organization_id_key")
  @@index([organizationId, patientId, requestedAt, createdAt])
  @@index([organizationId, clinicalEncounterId, requestedAt])
  @@index([organizationId, status, requestedAt])
  @@index([organizationId, category, requestedAt])
