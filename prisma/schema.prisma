generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organization is the tenant boundary for every future veterinary domain entity.
model Organization {
  id                     String                          @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                          @unique
  status                 OrganizationStatus              @default(ACTIVE)
  timezone               String                          @default("UTC")
  locale                 String                          @default("es-CO")
  currencyCode           String                          @default("COP") @map("currency_code")
  createdAt              DateTime                        @default(now()) @map("created_at")
  updatedAt              DateTime                        @updatedAt @map("updated_at")
  clinicLocations        ClinicLocation[]
  memberships            Membership[]
  owners                 Owner[]
  patients               Patient[]
  appointments           Appointment[]
  availabilityRules      AvailabilityRule[]
  professionalProfiles   MembershipProfessionalProfile[]
  clinicalRecords        ClinicalRecord[]
  clinicalEncounters     ClinicalEncounter[]
  clinicalEvolutions     ClinicalEvolution[]
  vitalMeasurements      VitalMeasurement[]
  clinicalAuditEvents    ClinicalAuditEvent[]
  prescriptions          Prescription[]
  clinicalProcedures     ClinicalProcedure[]
  clinicalSurgeryDetails ClinicalSurgeryDetail[]
  anesthesiaRecords      AnesthesiaRecord[]
  anesthesiaObservations AnesthesiaObservation[]
  vaccinations           Vaccination[]
  dewormings             Deworming[]
  hospitalizations       Hospitalization[]
  hospitalizationEntries HospitalizationEntry[]
  diagnosticOrders       DiagnosticOrder[]
  clinicalDocuments      ClinicalDocument[]
  consents               Consent[]
  consentSignatureRequests ConsentSignatureRequest[]

  @@map("organizations")
}

// A physical clinic location belongs to an organization but is not a tenant boundary.
model ClinicLocation {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  name               String
  status             ClinicLocationStatus @default(ACTIVE)
  address            String?
  city               String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appointments       Appointment[]
  availabilityRules  AvailabilityRule[]
  clinicalEncounters ClinicalEncounter[]

  @@unique([id, organizationId], map: "clinic_locations_id_organization_id_key")
  @@index([organizationId])
  @@map("clinic_locations")
}

// User is a global platform identity; organization access is represented by Membership.
model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  status       UserStatus   @default(ACTIVE)
  platformRole PlatformRole @default(USER) @map("platform_role")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  sessions     Session[]

  @@map("users")
}

// Membership is the explicit many-to-many link between a global user and a tenant.
model Membership {
  id                              String                         @id @default(uuid()) @db.Uuid
  userId                          String                         @map("user_id") @db.Uuid
  organizationId                  String                         @map("organization_id") @db.Uuid
  role                            MembershipRole                 @default(RECEPTION)
  clinicalRole                    ClinicalRole?                  @map("clinical_role")
  status                          MembershipStatus               @default(INVITED)
  createdAt                       DateTime                       @default(now()) @map("created_at")
  updatedAt                       DateTime                       @updatedAt @map("updated_at")
  user                            User                           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization                    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeSessions                  Session[]                      @relation("SessionActiveMembership")
  assignedAppointments            Appointment[]                  @relation("AppointmentAssignedMembership")
  createdAppointments             Appointment[]                  @relation("AppointmentCreatedByMembership")
  cancelledAppointments           Appointment[]                  @relation("AppointmentCancelledByMembership")
  availabilityRules               AvailabilityRule[]
  professionalProfile             MembershipProfessionalProfile?
  responsibleEncounters           ClinicalEncounter[]            @relation("EncounterResponsibleMembership")
  finalizedEncounters             ClinicalEncounter[]            @relation("EncounterFinalizedByMembership")
  voidedEncounters                ClinicalEncounter[]            @relation("EncounterVoidedByMembership")
  createdEncounters               ClinicalEncounter[]            @relation("EncounterCreatedByMembership")
  evolutionAuthors                ClinicalEvolution[]            @relation("EvolutionAuthorMembership")
  recordedVitalMeasurements       VitalMeasurement[]             @relation("VitalRecordedByMembership")
  clinicalAuditEvents             ClinicalAuditEvent[]           @relation("AuditActorMembership")
  createdPrescriptions            Prescription[]                 @relation("PrescriptionCreatedByMembership")
  prescribedPrescriptions         Prescription[]                 @relation("PrescriptionPrescribedByMembership")
  finalizedPrescriptions          Prescription[]                 @relation("PrescriptionFinalizedByMembership")
  voidedPrescriptions             Prescription[]                 @relation("PrescriptionVoidedByMembership")
  createdClinicalProcedures       ClinicalProcedure[]            @relation("ClinicalProcedureCreatedByMembership")
  responsibleClinicalProcedures   ClinicalProcedure[]            @relation("ClinicalProcedureResponsibleMembership")
  finalizedClinicalProcedures     ClinicalProcedure[]            @relation("ClinicalProcedureFinalizedByMembership")
  voidedClinicalProcedures        ClinicalProcedure[]            @relation("ClinicalProcedureVoidedByMembership")
  assistantClinicalSurgeryDetails ClinicalSurgeryDetail[]        @relation("ClinicalSurgeryDetailAssistantMembership")
  createdAnesthesiaRecords        AnesthesiaRecord[]             @relation("AnesthesiaRecordCreatedByMembership")
  responsibleAnesthesiaRecords    AnesthesiaRecord[]             @relation("AnesthesiaRecordResponsibleMembership")
  finalizedAnesthesiaRecords      AnesthesiaRecord[]             @relation("AnesthesiaRecordFinalizedByMembership")
  voidedAnesthesiaRecords         AnesthesiaRecord[]             @relation("AnesthesiaRecordVoidedByMembership")
  createdVaccinations             Vaccination[]                  @relation("VaccinationCreatedByMembership")
  responsibleVaccinations         Vaccination[]                  @relation("VaccinationResponsibleMembership")
  administeredVaccinations        Vaccination[]                  @relation("VaccinationAdministeredByMembership")
  finalizedVaccinations           Vaccination[]                  @relation("VaccinationFinalizedByMembership")
  voidedVaccinations              Vaccination[]                  @relation("VaccinationVoidedByMembership")
  createdDewormings               Deworming[]                    @relation("DewormingCreatedByMembership")
  responsibleDewormings           Deworming[]                    @relation("DewormingResponsibleMembership")
  administeredDewormings          Deworming[]                    @relation("DewormingAdministeredByMembership")
  finalizedDewormings             Deworming[]                    @relation("DewormingFinalizedByMembership")
  voidedDewormings                Deworming[]                    @relation("DewormingVoidedByMembership")
  createdHospitalizations         Hospitalization[]              @relation("HospitalizationCreatedByMembership")
  responsibleHospitalizations     Hospitalization[]              @relation("HospitalizationResponsibleMembership")
  activatedHospitalizations       Hospitalization[]              @relation("HospitalizationActivatedByMembership")
  dischargedHospitalizations      Hospitalization[]              @relation("HospitalizationDischargedByMembership")
  voidedHospitalizations          Hospitalization[]              @relation("HospitalizationVoidedByMembership")
  hospitalizationEntries          HospitalizationEntry[]         @relation("HospitalizationEntryRecordedByMembership")
  createdDiagnosticOrders         DiagnosticOrder[]              @relation("DiagnosticOrderCreatedByMembership")
  responsibleDiagnosticOrders     DiagnosticOrder[]              @relation("DiagnosticOrderResponsibleMembership")
  requestedDiagnosticOrders       DiagnosticOrder[]              @relation("DiagnosticOrderRequestedByMembership")
  resultedDiagnosticOrders        DiagnosticOrder[]              @relation("DiagnosticOrderResultedByMembership")
  voidedDiagnosticOrders          DiagnosticOrder[]              @relation("DiagnosticOrderVoidedByMembership")
  createdClinicalDocuments        ClinicalDocument[]              @relation("ClinicalDocumentCreatedByMembership")
  voidedClinicalDocuments         ClinicalDocument[]              @relation("ClinicalDocumentVoidedByMembership")
  createdConsents                 Consent[]                       @relation("ConsentCreatedByMembership")
  responsibleConsents             Consent[]                       @relation("ConsentResponsiblePractitionerMembership")
  issuedConsents                  Consent[]                       @relation("ConsentIssuedByMembership")
  voidedConsents                  Consent[]                       @relation("ConsentVoidedByMembership")
  createdConsentSignatureRequests ConsentSignatureRequest[]        @relation("ConsentSignatureRequestCreatedByMembership")
  revokedConsentSignatureRequests ConsentSignatureRequest[]        @relation("ConsentSignatureRequestRevokedByMembership")

  @@unique([userId, organizationId])
  @@unique([id, organizationId], map: "memberships_id_organization_id_key")
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

// Session stores only a hash of the random browser token and optional tenant context.
model Session {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  tokenHash          String      @unique @map("token_hash")
  activeMembershipId String?     @map("active_membership_id") @db.Uuid
  expiresAt          DateTime    @map("expires_at")
  revokedAt          DateTime?   @map("revoked_at")
  lastSeenAt         DateTime?   @map("last_seen_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  user               User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activeMembership   Membership? @relation("SessionActiveMembership", fields: [activeMembershipId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([activeMembershipId])
  @@index([expiresAt])
  @@map("sessions")
}

// Owner is a tenant-scoped responsible person; archive preserves future history.
model Owner {
  id                           String              @id @default(uuid()) @db.Uuid
  organizationId               String              @map("organization_id") @db.Uuid
  firstName                    String              @map("first_name")
  lastName                     String?             @map("last_name")
  documentType                 String?             @map("document_type")
  documentNumber               String?             @map("document_number")
  documentNumberNormalized     String?             @map("document_number_normalized")
  email                        String?
  phone                        String?
  secondaryPhone               String?             @map("secondary_phone")
  address                      String?
  city                         String?
  notes                        String?
  status                       OwnerStatus         @default(ACTIVE)
  archivedAt                   DateTime?           @map("archived_at")
  createdAt                    DateTime            @default(now()) @map("created_at")
  updatedAt                    DateTime            @updatedAt @map("updated_at")
  organization                 Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  patients                     Patient[]
  appointments                 Appointment[]
  historicalClinicalEncounters ClinicalEncounter[] @relation("EncounterHistoricalOwner")

  // The composite key supports a tenant-safe Patient foreign key.
  @@unique([id, organizationId], map: "owners_id_organization_id_key")
  // Optional identifiers are normalized and unique within one organization.
  @@unique([organizationId, documentType, documentNumberNormalized], map: "owners_org_document_key")
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, firstName])
  @@index([organizationId, lastName])
  // The migration also enforces status/archivedAt consistency at database level.
  @@map("owners")
}

// Patient is explicitly tenant-scoped even though it also references its Owner.
model Patient {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  ownerId            String              @map("owner_id") @db.Uuid
  name               String
  nameNormalized     String              @map("name_normalized")
  species            String
  breed              String?
  sex                PatientSex          @default(UNKNOWN)
  birthDate          DateTime?           @map("birth_date") @db.Date
  birthDateEstimated Boolean             @default(false) @map("birth_date_estimated")
  color              String?
  microchipNumber    String?             @map("microchip_number")
  // Numeric(20,6) preserves decimal weight snapshots without a species-specific cap.
  currentWeightKg    Decimal?            @map("current_weight_kg") @db.Decimal(20, 6)
  sterilized         Boolean             @default(false)
  notes              String?
  status             PatientStatus       @default(ACTIVE)
  archivedAt         DateTime?           @map("archived_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner              Owner               @relation(fields: [ownerId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  appointments       Appointment[]
  clinicalRecord     ClinicalRecord?
  clinicalEncounters ClinicalEncounter[]
  vitalMeasurements  VitalMeasurement[]
  prescriptions      Prescription[]
  clinicalProcedures ClinicalProcedure[]
  anesthesiaRecords  AnesthesiaRecord[]
  vaccinations       Vaccination[]       @relation("VaccinationPatient")
  dewormings         Deworming[]         @relation("DewormingPatient")
  hospitalizations   Hospitalization[]
  diagnosticOrders   DiagnosticOrder[]
  clinicalDocuments  ClinicalDocument[]
  consents           Consent[]

  @@unique([id, organizationId], map: "patients_id_organization_id_key")
  @@index([organizationId])
  @@index([organizationId, ownerId])
  @@index([organizationId, status])
  @@index([organizationId, nameNormalized])
  @@index([organizationId, microchipNumber])
  // Normalized names support search/order only; Patient.id remains the identity.
  @@map("patients")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ClinicLocationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum MembershipRole {
  OWNER
  ADMIN
  VETERINARIAN
  ASSISTANT
  RECEPTION
  GROOMER
  CASHIER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum OwnerStatus {
  ACTIVE
  ARCHIVED
}

enum PatientStatus {
  ACTIVE
  ARCHIVED
}

enum PatientSex {
  MALE
  FEMALE
  UNKNOWN
}

// ClinicalRole is orthogonal to MembershipRole and grants only clinical capabilities.
enum ClinicalRole {
  PRACTITIONER
  CLINICAL_ASSISTANT
}

enum ClinicalEncounterStatus {
  DRAFT
  FINALIZED
  VOIDED
}

enum PreventiveRecordStatus {
  DRAFT
  FINALIZED
  VOIDED
}

// Procedures and surgeries share one parent lifecycle; surgery-only details are an optional child aggregate.
enum ClinicalProcedureKind {
  PROCEDURE
  SURGERY
}

enum ClinicalProcedureStatus {
  DRAFT
  FINALIZED
  VOIDED
}

enum AnesthesiaRecordStatus {
  DRAFT
  FINALIZED
  VOIDED
}

enum ClinicalAuditEntityType {
  CLINICAL_RECORD
  CLINICAL_ENCOUNTER
  CLINICAL_EVOLUTION
  VITAL_MEASUREMENT
  PRESCRIPTION
  VACCINATION
  DEWORMING
  CLINICAL_PROCEDURE
  ANESTHESIA_RECORD
  HOSPITALIZATION
  DIAGNOSTIC_ORDER
  CLINICAL_DOCUMENT
  CONSENT
}

enum ClinicalAuditAction {
  CREATED
  UPDATED
  FINALIZED
  VOIDED
  EVOLUTION_ADDED
  VITAL_ADDED
  PRESCRIPTION_CREATED
  PRESCRIPTION_UPDATED
  PRESCRIPTION_FINALIZED
  PRESCRIPTION_VOIDED
  HOSPITALIZATION_CREATED
  HOSPITALIZATION_UPDATED
  HOSPITALIZATION_ACTIVATED
  HOSPITALIZATION_ENTRY_ADDED
  HOSPITALIZATION_DISCHARGED
  HOSPITALIZATION_VOIDED
  DIAGNOSTIC_ORDER_CREATED
  DIAGNOSTIC_ORDER_UPDATED
  DIAGNOSTIC_ORDER_REQUESTED
  DIAGNOSTIC_ORDER_RESULTED
  DIAGNOSTIC_ORDER_VOIDED
  DOCUMENT_GENERATED
  DOCUMENT_UPLOADED
  DOCUMENT_VOIDED
  CONSENT_CREATED
  CONSENT_UPDATED
  CONSENT_ISSUED
  CONSENT_SIGNED
  CONSENT_VOIDED
  SIGNATURE_REQUEST_REISSUED
}

// A tenant-scoped professional profile is optional for every membership.
model MembershipProfessionalProfile {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  membershipId   String       @unique @map("membership_id") @db.Uuid
  displayName    String       @map("display_name")
  licenseNumber  String?      @map("license_number")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership     Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId], map: "membership_professional_profiles_id_organization_id_key")
  @@unique([membershipId, organizationId], map: "membership_professional_profiles_membership_org_key")
  @@index([organizationId])
  @@map("membership_professional_profiles")
}

// One record is the stable clinical history root for one patient in one organization.
model ClinicalRecord {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  patientId         String              @map("patient_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  patient           Patient             @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  encounters        ClinicalEncounter[]
  evolutions        ClinicalEvolution[]
  vitalMeasurements VitalMeasurement[]

  @@unique([patientId, organizationId], map: "clinical_records_patient_organization_key")
  @@unique([organizationId, patientId], map: "clinical_records_organization_patient_key")
  @@unique([id, organizationId], map: "clinical_records_id_organization_id_key")
  @@map("clinical_records")
}

// Encounter stores the bounded clinical consultation state machine without workflow endpoints.
model ClinicalEncounter {
  id                              String                  @id @default(uuid()) @db.Uuid
  organizationId                  String                  @map("organization_id") @db.Uuid
  clinicalRecordId                String                  @map("clinical_record_id") @db.Uuid
  patientId                       String                  @map("patient_id") @db.Uuid
  ownerIdAtTime                   String                  @map("owner_id_at_time") @db.Uuid
  clinicLocationId                String                  @map("clinic_location_id") @db.Uuid
  appointmentId                   String?                 @map("appointment_id") @db.Uuid
  responsibleMembershipId         String?                 @map("responsible_membership_id") @db.Uuid
  status                          ClinicalEncounterStatus @default(DRAFT)
  version                         Int                     @default(1)
  reason                          String
  anamnesis                       String?
  physicalExam                    String?                 @map("physical_exam")
  presumptiveDiagnosis            String?                 @map("presumptive_diagnosis")
  differentialDiagnosis           String?                 @map("differential_diagnosis")
  definitiveDiagnosis             String?                 @map("definitive_diagnosis")
  diagnosticPlan                  String?                 @map("diagnostic_plan")
  therapeuticPlan                 String?                 @map("therapeutic_plan")
  recommendations                 String?
  followUpPlan                    String?                 @map("follow_up_plan")
  notes                           String?
  professionalDisplayNameSnapshot String?                 @map("professional_display_name_snapshot")
  professionalLicenseSnapshot     String?                 @map("professional_license_snapshot")
  finalizedAt                     DateTime?               @map("finalized_at") @db.Timestamptz(3)
  finalizedByMembershipId         String?                 @map("finalized_by_membership_id") @db.Uuid
  voidedAt                        DateTime?               @map("voided_at") @db.Timestamptz(3)
  voidedByMembershipId            String?                 @map("voided_by_membership_id") @db.Uuid
  voidReason                      String?                 @map("void_reason")
  occurredAt                      DateTime                @map("occurred_at") @db.Timestamptz(3)
  createdByMembershipId           String                  @map("created_by_membership_id") @db.Uuid
  createdAt                       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization                    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clinicalRecord                  ClinicalRecord          @relation(fields: [clinicalRecordId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  patient                         Patient                 @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  historicalOwner                 Owner                   @relation("EncounterHistoricalOwner", fields: [ownerIdAtTime, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  clinicLocation                  ClinicLocation          @relation(fields: [clinicLocationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  appointment                     Appointment?            @relation(fields: [appointmentId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  responsibleMembership           Membership?             @relation("EncounterResponsibleMembership", fields: [responsibleMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  finalizedByMembership           Membership?             @relation("EncounterFinalizedByMembership", fields: [finalizedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  voidedByMembership              Membership?             @relation("EncounterVoidedByMembership", fields: [voidedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  createdByMembership             Membership              @relation("EncounterCreatedByMembership", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  evolutions                      ClinicalEvolution[]
  vitalMeasurements               VitalMeasurement[]
  prescriptions                   Prescription[]
  vaccinations                    Vaccination[]           @relation("VaccinationEncounter")
  dewormings                      Deworming[]             @relation("DewormingEncounter")
  clinicalProcedures              ClinicalProcedure[]
  anesthesiaRecords               AnesthesiaRecord[]
  hospitalization                 Hospitalization?
  diagnosticOrders                DiagnosticOrder[]
  clinicalDocuments               ClinicalDocument[]
  consents                        Consent[]

  @@unique([id, organizationId], map: "clinical_encounters_id_organization_id_key")
  @@unique([id, organizationId, clinicalRecordId], map: "clinical_encounters_id_org_record_key")
  @@unique([id, organizationId, patientId], map: "clinical_encounters_id_org_patient_key")
  @@unique([appointmentId, organizationId], map: "clinical_encounters_appointment_org_key")
  @@index([organizationId, patientId, occurredAt])
  @@index([organizationId, clinicalRecordId, occurredAt])
  @@index([organizationId, responsibleMembershipId, occurredAt])
  @@index([organizationId, status])
  @@map("clinical_encounters")
}

enum HospitalizationStatus {
  DRAFT
  ACTIVE
  DISCHARGED
  VOIDED
}

enum HospitalizationEntryType {
  EVOLUTION
  MONITORING
  MEDICATION
  NURSING
  DIET
  OTHER
}

enum DiagnosticCategory {
  LABORATORY
  IMAGING
  PATHOLOGY
  OTHER
}

enum DiagnosticOrderStatus {
  DRAFT
  REQUESTED
  RESULTED
  VOIDED
}

enum ClinicalDocumentOrigin {
  GENERATED
  UPLOADED
}

enum ClinicalDocumentStatus {
  ACTIVE
  VOIDED
}

enum ClinicalDocumentType {
  PRESCRIPTION
  VACCINATION_CERTIFICATE
  PROCEDURE_REPORT
  ANESTHESIA_REPORT
  HOSPITALIZATION_DISCHARGE
  DIAGNOSTIC_RESULT
  SIGNED_CONSENT
  CLINICAL_ATTACHMENT
}

enum ClinicalDocumentSourceType {
  PRESCRIPTION
  VACCINATION
  CLINICAL_PROCEDURE
  ANESTHESIA_RECORD
  HOSPITALIZATION
  DIAGNOSTIC_ORDER
  CONSENT
}

enum ConsentStatus {
  DRAFT
  ISSUED
  SIGNED
  VOIDED
}

enum ConsentSignatureRequestStatus {
  PENDING
  SIGNED
  REVOKED
}

enum ConsentSignatureMethod {
  TYPED
  DRAWN
}

// A hospitalization is an audited episode rooted in one tenant-scoped encounter.
model Hospitalization {
  id                                  String                 @id @default(uuid()) @db.Uuid
  organizationId                      String                 @map("organization_id") @db.Uuid
  clinicalEncounterId                 String                 @map("clinical_encounter_id") @db.Uuid
  patientId                           String                 @map("patient_id") @db.Uuid
  status                              HospitalizationStatus  @default(DRAFT)
  version                             Int                    @default(1)
  admittedAt                          DateTime?              @map("admitted_at") @db.Timestamptz(3)
  dischargedAt                        DateTime?              @map("discharged_at") @db.Timestamptz(3)
  locationName                        String?                @map("location_name") @db.VarChar(160)
  admissionReason                     String?                @map("admission_reason") @db.VarChar(5000)
  diagnosis                           String?                @db.VarChar(10000)
  treatmentPlan                       String?                @map("treatment_plan") @db.VarChar(10000)
  medicationsText                     String?                @map("medications_text") @db.VarChar(10000)
  dietInstructions                    String?                @map("diet_instructions") @db.VarChar(5000)
  dischargeSummary                    String?                @map("discharge_summary") @db.VarChar(10000)
  dischargeRecommendations            String?                @map("discharge_recommendations") @db.VarChar(10000)
  notes                               String?                @db.VarChar(10000)
  responsiblePractitionerMembershipId String?                @map("responsible_practitioner_membership_id") @db.Uuid
  createdByMembershipId               String                 @map("created_by_membership_id") @db.Uuid
  patientNameSnapshot                 String?                @map("patient_name_snapshot") @db.VarChar(200)
  ownerDisplayNameSnapshot            String?                @map("owner_display_name_snapshot") @db.VarChar(300)
  professionalDisplayNameSnapshot     String?                @map("professional_display_name_snapshot") @db.VarChar(200)
