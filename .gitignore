# Dependencies and generated build output.
node_modules/
dist/
build/
coverage/
.vite/
.turbo/

# Environment files: keep only the documented template.
.env
.env.*
!.env.example

# Clinical document bytes are local runtime data and never belong in Git.
.easyvet-storage/

# Local logs, temporary files and editor metadata.
*.log
*.tmp
*.temp
.DS_Store
.idea/

# Local PostgreSQL/Prisma artifacts.
prisma/*.db
prisma/*.db-journal

# Test and tool caches.
.eslintcache
*.tsbuildinfo
reports/
# The API's reports module is source code, not generated report output.
!apps/api/src/reports/
!apps/api/src/reports/**
.playwright-cli/
