# Local development values only. Never use these placeholders in production.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://veterinary:veterinary_dev_only@localhost:5432/veterinary_saas
# Optional isolated PostgreSQL database for integration tests.
DATABASE_URL_TEST=postgresql://veterinary:veterinary_dev_only@localhost:5432/easyvet_test
