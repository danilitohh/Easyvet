EASYVET_DEMO_PASSWORD=EasyvetDemo!2026
APP_ORIGIN=http://localhost:5173

# Frontend Vite variables.
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Veterinary SaaS
VITE_DATA_MODE=api
