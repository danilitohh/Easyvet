# Local development values only. Never use these placeholders in production.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://veterinary:veterinary_dev_only@localhost:5432/easyvet_dev
# Optional isolated PostgreSQL database for integration tests.
DATABASE_URL_TEST=postgresql://veterinary:veterinary_dev_only@localhost:5432/easyvet_test
# Set a unique development-only seed password; PostgreSQL stores only its Argon2id hash.
EASYVET_DEMO_PASSWORD=replace-with-a-local-only-password
APP_ORIGIN=http://localhost:5173
# Optional one-time production super-admin bootstrap; use a unique 48-byte random secret.
# Remove it from Vercel after the first platform administrator has been created.
# PLATFORM_ADMIN_BOOTSTRAP_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
# Optional transactional email. In development, account links are written to the API log.
# Production email requires a Resend API key and a verified sender address/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Bootstrap defaults for new tenants; currency remains configurable per organization.
DEFAULT_CURRENCY_CODE=COP
DEFAULT_INVOICE_PREFIX=INV
SESSION_COOKIE_NAME=easyvet_session
SESSION_TTL_HOURS=168

# Clinical files default to a private local directory for development.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.easyvet-storage
STORAGE_S3_ENDPOINT=https://storage.example.com
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=easyvet-private
STORAGE_S3_ACCESS_KEY=replace-me
STORAGE_S3_SECRET_KEY=replace-me
STORAGE_S3_FORCE_PATH_STYLE=true
SIGNATURE_REQUEST_TTL_HOURS=72
SIGNATURE_REQUEST_MAX_ATTEMPTS=5

# Frontend Vite variables.
VITE_API_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Easyvet
VITE_DATA_MODE=api
# Supabase Realtime: Vercel's Marketplace integration supplies the NEXT_PUBLIC_* values
# for the browser and SUPABASE_JWT_SECRET for the API. For local development, set these only
# when connecting to a real Supabase project; never expose the JWT secret or secret key to Vite.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_JWT_SECRET=<server-only project JWT secret>
