{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node", "jest"],
    "paths": {
      "@veterinary-saas/config": ["../../packages/config/dist/index.d.ts"],
      "@veterinary-saas/contracts": ["../../packages/contracts/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
